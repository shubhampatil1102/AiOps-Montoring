# Frontend (Vite) environment. Copy this file to .env.local to override.
#
# Same-machine dev: leave VITE_API_URL unset — src/api/config.ts already
# defaults to http://localhost:4000 in dev mode.
#
# LAN / remote backend: point this at the backend machine's LAN IP so the
# React app (opened from any browser, on any machine) can reach it.
# VITE_API_URL=http://192.168.1.36:4000
