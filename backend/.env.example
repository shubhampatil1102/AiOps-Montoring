# Backend environment. Copy this file to .env (or set these in your
# process manager / Docker Compose environment) to override the defaults
# in src/config/env.ts.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=aiops

# Auth
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBERED=30

# CORS — comma-separated list of allowed frontend origins.
# Needed if an admin's browser reaches this backend from a non-localhost
# origin (e.g. the dev frontend opened via its LAN IP).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# When true (default), any http(s)://<private-LAN-IP>:<port> origin is also
# allowed automatically, in addition to CORS_ORIGIN, so you don't have to
# enumerate every machine's IP by hand. Never allows public internet
# origins. Set to "false" to require every origin to be listed explicitly.
CORS_ALLOW_LAN=true
